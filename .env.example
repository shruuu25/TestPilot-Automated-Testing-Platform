# TestPilot Environment Configuration

# Database Configuration (MySQL is default, SQLite fallback supported for local zero-dependency testing)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/testpilot
# Fallback SQLite example:
# DATABASE_URL=sqlite:///./testpilot.db

# API and Frontend URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Selenium Automation
HEADLESS=true
SELENIUM_BROWSER=chrome
SELENIUM_IMPLICIT_WAIT=10
